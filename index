<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Registro KFL</title>
  
  <!-- Favicon usando la imagen oficial local -->
  <link rel="icon" type="image/png" href="logo.png">

  <!-- Fuente Montserrat -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Montserrat', 'sans-serif'],
          },
          colors: {
            kflRed: '#E61C24',
            kflBlue: '#0B3B80',
          }
        }
      }
    }
  </script>
</head>
<body class="bg-slate-950 text-slate-100 font-sans min-h-screen flex items-center justify-center p-4 relative overflow-x-hidden">

  <!-- Fondo Decorativo -->
  <div class="absolute top-[-10%] left-[-10%] w-96 h-96 bg-kflRed/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-[-10%] right-[-10%] w-96 h-96 bg-kflBlue/20 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Contenedor Principal -->
  <div class="w-full max-w-lg bg-slate-900/90 border border-slate-800 rounded-2xl shadow-2xl p-6 sm:p-8 backdrop-blur-md z-10">
    
    <!-- Header con Logo Oficial KFL -->
    <div class="text-center mb-8">
      <img src="logo.png" alt="KFL Logo" class="w-32 h-32 mx-auto mb-4 object-contain drop-shadow-lg">
      <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white uppercase">
        Formulario de Registro
      </h1>
      <p class="text-xs sm:text-sm text-slate-400 mt-1 font-medium">
        Kiwanis Football League • Cupos limitados (Máx. 120)
      </p>
    </div>

    <!-- Formulario -->
    <form id="registroForm" class="space-y-4">
      
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Nombre</label>
          <input type="text" id="nombre" required placeholder="Ej: Juan" 
                 class="w-full bg-slate-800/80 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-kflRed transition-colors">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Apellido</label>
          <input type="text" id="apellido" required placeholder="Ej: Pérez" 
                 class="w-full bg-slate-800/80 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-kflRed transition-colors">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Equipo</label>
          <input type="text" id="equipo" required placeholder="Nombre del equipo" 
                 class="w-full bg-slate-800/80 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-kflRed transition-colors">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Categoría</label>
          <input type="text" id="categoria" required placeholder="Ej: Varsity, Contact..." 
                 class="w-full bg-slate-800/80 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-kflRed transition-colors">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">Correo Electrónico</label>
        <input type="email" id="correo" required placeholder="tu@correo.com" 
               class="w-full bg-slate-800/80 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-kflRed transition-colors">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1">WhatsApp</label>
        <input type="tel" id="whatsapp" required placeholder="50760000000" 
               class="w-full bg-slate-800/80 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-kflRed transition-colors">
        <p class="text-[10px] text-slate-500 mt-1">Incluye el código de país sin símbolos (+).</p>
      </div>

      <button type="submit" id="btnSubmit" 
              class="w-full mt-2 bg-gradient-to-r from-kflRed to-red-700 hover:from-red-600 hover:to-red-800 text-white font-bold py-3 px-4 rounded-lg shadow-lg hover:shadow-red-900/40 transition-all transform active:scale-[0.99]">
        Completar Registro
      </button>

    </form>

    <!-- Estado / Mensajes -->
    <div id="mensaje" class="mt-4 p-3 rounded-lg text-center text-sm font-medium hidden"></div>

  </div>

  <script>
    // Reemplaza esta URL con la que te da Google Apps Script al implementar como Web App
    const SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbxV7Cb4LxH-uxWZxsfhcSmVcEs-1svaF5ZhjFAs18UnnjNdwU5Ocs6r7xFXrtlWrUPr/exec';

    document.getElementById('registroForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const btn = document.getElementById('btnSubmit');
      const mensajeDiv = document.getElementById('mensaje');

      btn.disabled = true;
      btn.innerHTML = 'Procesando...';
      mensajeDiv.classList.add('hidden');

      const payload = {
        nombre: document.getElementById('nombre').value.trim(),
        apellido: document.getElementById('apellido').value.trim(),
        equipo: document.getElementById('equipo').value.trim(),
        categoria: document.getElementById('categoria').value.trim(),
        correo: document.getElementById('correo').value.trim(),
        whatsapp: document.getElementById('whatsapp').value.trim()
      };

      try {
        const response = await fetch(SCRIPT_URL, {
          method: 'POST',
          mode: 'cors',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload)
        });

        const res = await response.json();

        mensajeDiv.classList.remove('hidden');

        if (res.status === 'success') {
          mensajeDiv.className = 'mt-4 p-3 bg-emerald-950/80 border border-emerald-500/50 text-emerald-300 rounded-lg text-center text-sm font-medium';
          mensajeDiv.innerText = '¡Registro exitoso! Revisa tu correo y WhatsApp.';
          document.getElementById('registroForm').reset();
        } else if (res.status === 'limit_reached') {
          mensajeDiv.className = 'mt-4 p-3 bg-amber-950/80 border border-amber-500/50 text-amber-300 rounded-lg text-center text-sm font-medium';
          mensajeDiv.innerText = 'Lo sentimos, el cupo de 120 registros ha sido alcanzado.';
        } else {
          mensajeDiv.className = 'mt-4 p-3 bg-rose-950/80 border border-rose-500/50 text-rose-300 rounded-lg text-center text-sm font-medium';
          mensajeDiv.innerText = 'Error: ' + res.message;
        }
      } catch (error) {
        mensajeDiv.classList.remove('hidden');
        mensajeDiv.className = 'mt-4 p-3 bg-rose-950/80 border border-rose-500/50 text-rose-300 rounded-lg text-center text-sm font-medium';
        mensajeDiv.innerText = 'Ocurrió un error al enviar el formulario. Intenta nuevamente.';
      } finally {
        btn.disabled = false;
        btn.innerHTML = 'Completar Registro';
      }
    });
  </script>
</body>
</html>
